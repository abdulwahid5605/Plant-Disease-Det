{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],

    "module": "CommonJS",
    "moduleResolution": "node",

    "jsx": "react-jsx",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "types": ["jest", "node"],

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "src/__tests__"]
}
